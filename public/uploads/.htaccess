# Cegah eksekusi skrip PHP atau CGI di direktori upload publik
<FilesMatch "(?i)\.(php|php[0-9]|phtml|phar|pl|py|cgi|sh|asp|aspx)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

Options -Indexes
